# API Keys Configuration
# Copy this file to .env and fill in your API keys.

# ============================================
# APIs Requiring Keys or Authentication
# ============================================

# GitHub API
# A personal access token is recommended to increase the rate limit.
# Get one here: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_personal_access_token_here

# Spotify API (OAuth 2.0)
# Get credentials here: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# YouTube Data API v3
# Get an API key here: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_youtube_api_key_here

# The Movie Database (TMDb) API
# Get an API key here: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Twitter/X API v2
# Apply for a developer account and get keys here: https://developer.twitter.com/en/portal/dashboard
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# Reddit API
# Create an app to get credentials: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=your_reddit_user_agent_here

# Discord API
# Create a bot and get a token: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Steam API
# Get an API key here: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your_steam_api_key_here

# Twitch API
# Register an application to get credentials: https://dev.twitch.tv/console
TWITCH_CLIENT_ID=your_twitch_client_id_here
TWITCH_CLIENT_SECRET=your_twitch_client_secret_here

# Zenodo API
# Create a personal access token: https://zenodo.org/account/settings/applications/
ZENODO_ACCESS_TOKEN=your_zenodo_access_token_here

# PubMed API (Optional, to increase rate limits)
# Get an API key here: https://www.ncbi.nlm.nih.gov/account/
PUBMED_API_KEY=your_pubmed_api_key_here

# ============================================
# APIs Not Requiring Keys (Included for clarity)
# ============================================
# The following APIs do not require configuration and can be used directly.
# Note: Some may have lower rate limits for unauthenticated requests (e.g., GitHub).
# - NPM Registry
# - PyPI
# - Docker Hub
# - Crates.io
# - RubyGems
# - NuGet
# - Go Proxy
# - Conda
# - CRAN
# - Maven Central
# - DBLP
# - Open Library
# - SEC EDGAR
# - crt.sh
# - OpenStreetMap
# - Data.gov